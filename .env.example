# Vite Environment Variables
# Copy this file to .env.local and update with your production values

# API URL for the backend server
# Default (local development): http://localhost:3001
# Production: Replace with your actual backend URL (e.g., https://api.vichisboh.com)
VITE_API_URL=http://localhost:3001

# Example for production:
# VITE_API_URL=https://backend.yourdomain.com
